<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/17.0.6"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.zenwealth.controller.DialogController"
           fx:id="rootPane"
           prefWidth="420">

    <GridPane fx:id="formGrid"
              hgap="10" vgap="8" alignment="TOP_LEFT"
              style="-fx-padding: 15;">

        <Label text="类型:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  prefWidth="280"/>

        <Label text="名称:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   promptText="输入资产名称"/>

        <Label fx:id="extraLabel1" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="extraField1" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label fx:id="extraLabel2" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="extraField2" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label fx:id="extraLabel3" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="extraField3" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <ListView fx:id="searchList" visible="false" managed="false"
              maxHeight="180" prefWidth="280"
              StackPane.alignment="TOP_LEFT"/>
</StackPane>
