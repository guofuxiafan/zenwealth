<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.zenwealth.controller.MainController"
            prefWidth="1000" prefHeight="680"
            style="-fx-background-color: #F3F4F6;">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 12 20 12 20; -fx-background-color: linear-gradient(to right, #1E293B, #334155); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 2);">
            <Label text="◈  ZenWealth"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" text="总资产  ¥0.00"
                   style="-fx-font-size: 15px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
            <Button fx:id="refreshButton" text="⟳ 刷新"
                    style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 16 6 16; -fx-cursor: hand;"/>
            <Button fx:id="addButton" text="＋ 新增"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 16 6 16; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 2, 0);">
            <Label text="资产分类"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B7280; -fx-padding: 14 16 6 16;"/>
            <ListView fx:id="sidebarList" prefWidth="155"
                      style="-fx-font-size: 13px; -fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;">
                <padding><Insets top="0" right="0" bottom="8" left="0"/></padding>
            </ListView>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);"
              VBox.vgrow="ALWAYS">
            <padding><Insets top="10" right="14" bottom="0" left="14"/></padding>

            <StackPane fx:id="tableArea" VBox.vgrow="ALWAYS"/>

            <HBox fx:id="buttonBar" spacing="8" alignment="CENTER_LEFT"
                  style="-fx-padding: 8 0 8 0;">
                <Button fx:id="editButton" text="✎ 修改"
                        style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151; -fx-background-radius: 5; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
                <Button fx:id="deleteButton" text="✕ 删除"
                        style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-background-radius: 5; -fx-padding: 5 14 5 14; -fx-cursor: hand;"/>
            </HBox>

            <Label fx:id="sectionTitle" text="资产占比"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B7280; -fx-padding: 0 0 4 0;"/>

            <StackPane fx:id="barArea" prefHeight="85"
                       style="-fx-padding: 0 0 10 0;"/>
        </VBox>
    </center>

</BorderPane>
